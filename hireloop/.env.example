# Copy to .env (gitignored) and fill in. Real environment variables override these.

# --- Email alert after each submitted application ---
# The Gmail address that receives the alerts.
WELLFOUND_EMAIL_TO=
# The account that sends them. Leave blank to send from WELLFOUND_EMAIL_TO to itself.
WELLFOUND_SMTP_USER=
# A Gmail APP PASSWORD for the sending account, not its normal password.
# Needs 2-Step Verification on, then: https://myaccount.google.com/apppasswords
WELLFOUND_SMTP_PASSWORD=

# --- Optional ---
# WELLFOUND_DAILY_START=5
# WELLFOUND_DAILY_LIMIT=15
# WELLFOUND_HEADLESS=0
